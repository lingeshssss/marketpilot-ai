# MarketPilot — environment variables (no real values here; never commit secrets)
# Every variable is optional at boot. A missing dependency switches the related
# feature to an explicit "unavailable" state; nothing falls back to fake data.

# ---- App ----
APP_URL=                      # public origin, e.g. https://marketpilot-ai-gilt.vercel.app (Vercel sets VERCEL_URL for previews)
TRUSTED_ORIGINS=              # optional extra comma-separated origins allowed for auth/state-changing requests

# ---- Database (Postgres: Neon, Supabase, RDS…) — required for accounts, saved data, scanner, alerts ----
DATABASE_URL=                 # use the POOLED connection string on serverless hosts
DATABASE_POOL_MAX=3
DATABASE_SSL=                 # true/false; auto-enabled for neon/supabase URLs

# ---- Authentication (Better Auth) ----
BETTER_AUTH_SECRET=           # 32+ random bytes: openssl rand -hex 32

# ---- Market data ----
MARKET_DATA_PROVIDER=         # massive | demo (demo = synthetic, labelled; refused in production unless allowed below)
MASSIVE_API_KEY=              # https://massive.com (formerly Polygon.io). POLYGON_API_KEY is also accepted.
MASSIVE_PLAN=basic            # basic | starter | developer | advanced | business — sets capabilities and call budget
MASSIVE_RATE_LIMIT_PER_MIN=   # override the plan's default budget (basic: 5)
MASSIVE_BASE_URL=             # default https://api.massive.com
ALLOW_DEMO_DATA_IN_PRODUCTION=false

# ---- AI explanations (Anthropic) ----
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
AI_MAX_TOKENS=8000
AI_DAILY_LIMIT_PER_USER=20
AI_DAILY_LIMIT_GLOBAL=300     # hard cost ceiling per day across all users
AI_FALLBACKS=default          # server-side refusal fallback; set "off" to disable

# ---- Email (verification, password reset, alert delivery) ----
RESEND_API_KEY=
EMAIL_FROM=                   # e.g. "MarketPilot <alerts@yourdomain.com>" (domain verified in Resend)
EMAIL_TRANSPORT=              # resend | outbox (outbox = dev/test sink, refused in production)

# ---- Background jobs ----
CRON_SECRET=                  # 32+ random chars; Vercel Cron sends it as a Bearer token

# ---- Limits (optional) ----
API_RATE_LIMIT_PER_MIN=300
MAX_ALERT_RULES_PER_USER=50
MAX_WATCHLISTS_PER_USER=20
MAX_ITEMS_PER_WATCHLIST=200
MAX_PORTFOLIOS_PER_USER=20
MAX_TRANSACTIONS_PER_PORTFOLIO=10000
LOG_LEVEL=                    # debug | silent
