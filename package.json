{
  "name": "marketpilot-ai",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "node scripts/build.js",
    "migrate": "node scripts/migrate.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/*.test.js\"",
    "test:e2e": "playwright test",
    "smoke:provider": "node scripts/smoke-provider.js",
    "check": "node scripts/check.js",
    "backfill": "node scripts/backfill.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "better-auth": "^1.7.10",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-socket": "^0.2.13",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "lightweight-charts": "^5.2.1",
    "typescript": "^5.9.3"
  }
}
